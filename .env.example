# Copy this file to .env and add your own key. Never commit .env.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your-groq-key-here

# To use Gemini instead, set LLM_PROVIDER=gemini, choose a Gemini model and add:
# GEMINI_API_KEY=your-gemini-key-here

# To run without any key, set LLM_PROVIDER=offline (reuses the saved theme cache and narrative)